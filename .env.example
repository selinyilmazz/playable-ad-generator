# OpenRouter API key (bkz. https://openrouter.ai/keys)
# Ali Bey key sağlayınca bu dosyayı .env olarak kopyala ve değeri doldur.
OPENROUTER_API_KEY=

# Sunucu portu (opsiyonel, varsayılan 3000)
PORT=3000

# Kullanılacak OpenRouter model id'si (opsiyonel; boş bırakılırsa
# server/config/models.js içindeki varsayılan kullanılır).
# ROUND 19 (Part D): varsayılan "deepseek/deepseek-v4-flash-0731" —
# önce "qwen/qwen3.8-flash" denendi ama Alibaba'nın (Qwen'in TEK
# provider'ı) upstream shared-pool'u rate-limit verdi; DeepSeek 28 farklı
# provider üzerinden sunulduğu için bu riske karşı çok daha dayanıklı
# (bkz. models.js "ROUND 19 NOTU (Part D)"). qwen/qwen3.8-flash hâlâ
# geçerli bir seçenek — istersen bu satıra yazarak tekrar seçebilirsin.
# Farklı bir model denemek istersen sadece bu satıra gerçek OpenRouter
# model id'sini yaz (ör. openai/... veya google/...) — kodda hiçbir yeri
# değiştirmen gerekmez.
OPENROUTER_MODEL=
