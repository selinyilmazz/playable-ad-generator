# OpenRouter API key (bkz. https://openrouter.ai/keys)
# Ali Bey key sağlayınca bu dosyayı .env olarak kopyala ve değeri doldur.
OPENROUTER_API_KEY=

# Sunucu portu (opsiyonel, varsayılan 3000)
PORT=3000

# Kullanılacak OpenRouter model id'si (opsiyonel; boş bırakılırsa
# server/config/models.js içindeki varsayılan kullanılır).
# ROUND 19 (Part D): varsayılan "deepseek/deepseek-v4-flash-0731" —
# önce "qwen/qwen3.8-flash" denendi ama Alibaba'nın (Qwen'in TEK
# provider'ı) upstream shared-pool'u rate-limit verdi; DeepSeek 28 farklı
# provider üzerinden sunulduğu için bu riske karşı çok daha dayanıklı
# (bkz. models.js "ROUND 19 NOTU (Part D)"). qwen/qwen3.8-flash hâlâ
# geçerli bir seçenek — istersen bu satıra yazarak tekrar seçebilirsin.
# Farklı bir model denemek istersen sadece bu satıra gerçek OpenRouter
# model id'sini yaz (ör. openai/... veya google/...) — kodda hiçbir yeri
# değiştirmen gerekmez.
OPENROUTER_MODEL=

# PRODUCTION BYOK SECURITY FIX — server-side OPENROUTER_API_KEY yukarida
# tanimli olsa bile, varsayilan olarak (bu flag false/undefined iken)
# KULLANILMAZ. Gercek AI cagrisi SADECE kullanicinin kendi BYOK key'iyle
# yapilir; BYOK yoksa generate/autofix/improve mock davranisina duser.
# Sadece LOCAL DEVELOPMENT icin, .env'deki OPENROUTER_API_KEY'i BYOK
# olmadan da kullanmak istiyorsan true yap. PRODUCTION'da bu satiri
# false/undefined birak (veya hic ekleme).
ALLOW_SERVER_API_KEY=false

# SUPABASE AUTHENTICATION FOUNDATION round -- bkz. server/config/supabase.js
# ve public/app.js initAuth(). SUPABASE_URL/SUPABASE_ANON_KEY frontend'e
# GET /api/auth/config uzerinden (SADECE bu iki, public-safe deger) servis
# edilir. SUPABASE_SERVICE_ROLE_KEY SADECE server tarafinda kullanilir,
# ASLA frontend'e gonderilmez/loglanmaz. Hicbiri burada gercek bir deger
# TASIMAMALI -- bu sadece bir sablon dosyasi.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PERSISTENT USER OPENROUTER API KEYS (Phase 3) round -- server-only master
# key used to encrypt/decrypt each signed-in user's saved OpenRouter API key
# at rest (AES-256-GCM, bkz. server/services/apiKeyCrypto.js). This is a
# SEPARATE secret from OPENROUTER_API_KEY/SUPABASE_* above -- it never
# leaves this server process, is never sent to Supabase, and is never
# derivable from anything Supabase stores.
#
# Format: base64-encoded, MUST decode to exactly 32 bytes (AES-256 key).
# Generate one with:
#   openssl rand -base64 32
#
# MUST be stored ONLY as a server-side secret (this file is a template --
# never put a real value here, never commit a real value anywhere).
#
# Losing this key makes every already-saved user API key permanently
# UNRECOVERABLE (there is no plaintext anywhere to fall back to -- this is
# intentional, see the Phase 3 architecture analysis). Back it up with at
# least the same care as SUPABASE_SERVICE_ROLE_KEY.
#
# Rotating this key is NOT a simple drop-in replacement: every existing
# row in `api_keys` was encrypted with the OLD key and must be decrypted
# with it before being re-encrypted with the NEW one (a planned migration/
# rotation procedure -- see key_version column in the api_keys table,
# added for exactly this purpose). Do not change this value in production
# without such a procedure, or every currently-saved user key becomes
# undecryptable.
API_KEY_ENCRYPTION_KEY=
